# ── Database ──────────────────────────────────────────────────────────
# Local: docker compose up -d. Production: Railway Postgres — its URL lives
# in Vercel env + the GitHub Actions secret and must NEVER be the active
# value here: drizzle-kit auto-loads .env, so local migrations would hit
# production. A deliberate prod operation passes the URL inline instead
# (the shell environment beats env files):
#   DATABASE_URL="<prod-url>" pnpm db:migrate
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/larder

# ── Auth (Better Auth) ────────────────────────────────────────────────
# Generate: openssl rand -base64 32  (must be >= 32 chars)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Google Cloud Console -> Credentials -> OAuth 2.0 Client ID.
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (Resend) ────────────────────────────────────────────────────
# Production requires a verified custom domain in Resend.
RESEND_API_KEY=
EMAIL_FROM=Larder <noreply@localhost>

# ── AI (OpenAI) ───────────────────────────────────────────────────────
OPENAI_API_KEY=
# Hard monthly cap for AI spend, USD. Assistant switches off at the cap.
AI_MONTHLY_BUDGET_USD=20

# ── Recipe import fallback (FireCrawl) ────────────────────────────────
FIRECRAWL_API_KEY=

# ── Image uploads (UploadThing) ───────────────────────────────────────
UPLOADTHING_TOKEN=

# ── App ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
